PORT=3000

DB_HOST=127.0.0.1
# Jika NestJS berjalan dalam Compose lokal, app memakai DB_HOST=mysql dan DB_PORT=3306.
# Production: set DB_HOST ke hostname/IP privat MySQL existing, bukan MySQL Compose lokal.
DB_PORT=3306
DB_NAME=legacy_local
DB_USER=legacy_reader
DB_PASSWORD=

NOTIFICATION_DB_USER=notification_writer
NOTIFICATION_DB_PASSWORD=

FONNTE_TOKEN=
FONNTE_TEST_PHONE=
FITTING_REMINDER_ENABLED=false
INTERNAL_API_KEY=
