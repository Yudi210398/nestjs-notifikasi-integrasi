{
  "name": "whatsapp-notification-service",
  "version": "1.0.0",
  "private": true,
  "description": "Internal NestJS service for WhatsApp notifications integrated with the existing PHP system.",
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:legacy": "npm run build && node --test test/*.test.cjs",
    "test:notification-log:integration": "jest --config jest.integration.config.cjs --runInBand",
    "test:smoke": "npm run build && node test/legacy-read.smoke.cjs",
    "format": "prettier --write \"src/**/*.ts\" \"prisma.config.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\"",
    "check-all": "npm test && npm run test:legacy && npm run test:notification-log:integration && npm run lint && npm run build && git diff --check && git status"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@prisma/client": "^6.19.3",
    "dotenv": "^16.6.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.2.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.4",
    "eslint": "^9.18.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "prisma": "^6.19.3",
    "ts-jest": "^29.4.12",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.22.0"
  }
}
