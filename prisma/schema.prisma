generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model email_set {
  id       Int    @id @default(autoincrement())
  email    String @db.VarChar(255)
  password String @db.VarChar(255)
}

model gambar_baju {
  baju_id   Int    @id @default(autoincrement())
  custom_id Int
  bawah     Int?
  img       String @db.VarChar(255)
}

model order_accents {
  order_accents_id  Int    @id @default(autoincrement())
  order_id          Int
  pelanggan_id      Int
  order_accents_ket String @db.Text
}

model tbl_bahan {
  bahan_id     Int           @id @default(autoincrement())
  category_id  Int?
  nama         String        @db.VarChar(255)
  keterangan   String?       @db.Text
  image        String?       @db.VarChar(255)
  tbl_category tbl_category? @relation(fields: [category_id], references: [category_id], onDelete: Cascade, onUpdate: NoAction, map: "tbl_bahan_ibfk_1")

  @@index([category_id], map: "category_id")
}

model tbl_category {
  category_id   Int         @id @default(autoincrement())
  category_nama String      @db.VarChar(255)
  category_ket  String?     @db.VarChar(255)
  kd_kwt        String      @db.VarChar(255)
  tbl_bahan     tbl_bahan[]
}

model tbl_custom {
  custom_id       Int     @id @default(autoincrement())
  sub_category_id Int
  id_type         Int
  custom_nama     String  @db.VarChar(255)
  custom_ket      String? @db.VarChar(255)
  custom_img      String  @db.VarChar(255)
}

model tbl_detail_gambar {
  id         Int        @id @default(autoincrement())
  order_id   Int?
  jenis      String?    @db.VarChar(255)
  keterangan String?    @db.Text
  gambar     String     @db.VarChar(255)
  created_at DateTime?  @db.Timestamp(0)
  updated_at DateTime?  @db.Timestamp(0)
  tbl_order  tbl_order? @relation(fields: [order_id], references: [order_id], onDelete: Cascade, onUpdate: NoAction, map: "tbl_detail_gambar_ibfk_1")

  @@index([order_id], map: "order_id")
}

model tbl_fitting {
  fitting_id     Int     @id @default(autoincrement())
  order_id       Int
  fitting_status String? @db.VarChar(255)
}

model tbl_gallery {
  gallery_id      Int     @id @default(autoincrement())
  category_id     Int?
  sub_category_id Int
  order_id        Int
  pelanggan_id    Int?
  no_kw           String? @db.VarChar(255)
  gallery_ket     String? @db.VarChar(255)
  gallery_img     String  @db.VarChar(255)
}

model tbl_order {
  order_id            Int                   @id @default(autoincrement())
  pelanggan_id        Int
  model_id            Int?
  no_kw               String?               @unique(map: "no_kw") @db.VarChar(255)
  tgl_input           DateTime              @db.Date
  tgl_coba            DateTime?             @db.Date
  tgl_selesai         DateTime              @db.Date
  category_id         Int
  order_status        String                @db.VarChar(255)
  order_ket           String?               @db.VarChar(255)
  qty                 Int
  keterangan1         String?               @db.Text
  flui_celana         Int?
  uk_jas              Int?
  uk_ps               Int?
  jeans               Int?
  pengambil           String?               @db.VarChar(255)
  tbl_detail_gambar   tbl_detail_gambar[]
  tbl_uk_baju_order   tbl_uk_baju_order[]
  tbl_uk_celana_order tbl_uk_celana_order[]
  tbl_uk_jas_order    tbl_uk_jas_order[]
  tbl_uk_ps_order     tbl_uk_ps_order[]
  tbl_uk_rompi_order  tbl_uk_rompi_order[]
  tbl_ukuran_order    tbl_ukuran_order[]
}

model tbl_order_custom {
  order_custom_id  Int     @id @default(autoincrement())
  order_id         Int
  sub_category_id  Int
  custom_id        Int
  order_custom_ket String? @db.VarChar(255)
}

model tbl_pegawai {
  pegawai_id    Int    @id @default(autoincrement())
  pegawai_nama  String @db.VarChar(50)
  pegawai_pass  String @db.VarChar(50)
  pegawai_email String @db.VarChar(255)
}

model tbl_pelanggan {
  pelanggan_id     Int      @id @default(autoincrement())
  pelanggan_nama   String   @db.VarChar(255)
  pelanggan_hp     String?  @db.VarChar(255)
